<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.knowledge.base.document.mapper.CategoryMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.knowledge.base.document.entity.Category">
        <id column="id" property="id" />
        <result column="parent_id" property="parentId" />
        <result column="category_name" property="categoryName" />
        <result column="category_code" property="categoryCode" />
        <result column="description" property="description" />
        <result column="category_icon" property="icon" />
        <result column="sort" property="sort" />
        <result column="status" property="status" />
        <result column="document_count" property="documentCount" />
        <result column="remark" property="remark" />
        <result column="deleted" property="deleted" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
        <result column="create_by" property="createBy" />
        <result column="update_by" property="updateBy" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, parent_id, category_name, category_code, description, category_icon, sort, status, document_count, remark,
        deleted, created_at, updated_at, create_by, update_by
    </sql>

    <!-- 根据父分类ID查询子分类列表 -->
    <select id="selectByParentId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM kb_category
        WHERE parent_id = #{parentId}
        AND deleted = 0
        ORDER BY sort ASC, created_at DESC
    </select>

    <!-- 根据分类编码查询分类 -->
    <select id="selectByCategoryCode" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM kb_category
        WHERE category_code = #{categoryCode}
        AND deleted = 0
        LIMIT 1
    </select>

    <!-- 根据状态查询分类列表 -->
    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM kb_category
        WHERE status = #{status}
        AND deleted = 0
        ORDER BY sort ASC
    </select>

    <!-- 查询所有根分类 -->
    <select id="selectRootCategories" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM kb_category
        WHERE parent_id = 0
        AND deleted = 0
        ORDER BY sort ASC
    </select>

    <!-- 更新文档数量 -->
    <update id="updateDocumentCount">
        UPDATE kb_category
        SET document_count = #{count}
        WHERE id = #{categoryId}
        AND deleted = 0
    </update>

    <!-- 增加文档数量 -->
    <update id="incrementDocumentCount">
        UPDATE kb_category
        SET document_count = document_count + 1
        WHERE id = #{categoryId}
        AND deleted = 0
    </update>

    <!-- 减少文档数量 -->
    <update id="decrementDocumentCount">
        UPDATE kb_category
        SET document_count = GREATEST(document_count - 1, 0)
        WHERE id = #{categoryId}
        AND deleted = 0
    </update>

    <!-- 检查分类编码是否存在 -->
    <select id="checkCategoryCodeExists" resultType="java.lang.Boolean">
        SELECT COUNT(*) > 0
        FROM kb_category
        WHERE category_code = #{categoryCode}
        AND deleted = 0
        <if test="id != null">
            AND id != #{id}
        </if>
    </select>

</mapper>
