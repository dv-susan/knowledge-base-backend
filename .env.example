# =============================================================================
# 企业知识库 - 本地开发环境变量配置
# =============================================================================
#
# 使用方法:
#   1. 复制此文件为 .env:
#      cp .env.example .env
#
#   2. 填入你自己的 API Key、邮箱密码等:
#      vim .env
#
#   3. 每次启动前加载环境变量:
#      source .env
#      然后正常启动服务
#
# =============================================================================

# =============================================================================
# 电脑标识配置（必填）
# =============================================================================
# 每个开发者必须设置唯一的 COMPUTER_ID，用于在 Nacos 服务注册时
# 隔离不同电脑的服务实例。如果不设置，会使用系统用户名 ${USER} 作为默认值。
#
# 示例:
#   COMPUTER_ID=zhangsan
#   COMPUTER_ID=dev01
COMPUTER_ID=mac

# =============================================================================
# 大模型配置（可选，不配置则 AI 功能不可用）
# =============================================================================

# --- 通义千问（默认模型）---
# 获取 API Key: https://dashscope.console.aliyun.com/
# 免费额度: 新用户赠送 200 万 Tokens（qwen3-max）
QWEN_API_KEY=your-qwen-api-key-here
# 模型名称（可选，默认 qwen3-max）
# QWEN_MODEL=qwen3-max
# API 地址（可选，一般不需要改）
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- DeepSeek（可选，第二个模型）---
# 获取 API Key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# --- AI 默认模型 ---
# 可选值: qwen | deepseek（默认 qwen）
# AI_DEFAULT_MODEL=qwen

# =============================================================================
# RAG / 向量检索配置（可选，不配置则 RAG 功能降级）
# =============================================================================
# RAG_ENABLED=true
# RAG_CHUNK_SIZE=512
# RAG_CHUNK_OVERLAP=64

# =============================================================================
# Elasticsearch 配置（RAG/KAG 向量存储，可选）
# =============================================================================
# ELASTICSEARCH_URIS=http://localhost:9200

# =============================================================================
# Neo4j 配置（知识图谱，可选）
# =============================================================================
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-password

# =============================================================================
# 邮箱配置（必填，用于账户激活邮件和密码重置）
# =============================================================================
#
# 以 163 邮箱为例:
#   1. 登录 mail.163.com
#   2. 设置 → POP3/SMTP/IMAP → 开启 SMTP 服务
#   3. 获取授权码（不是登录密码！）
#   4. 填入下方 MAIL_PASSWORD
#
# 163 邮箱:
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=your-email@163.com
MAIL_PASSWORD=your-smtp-auth-code

# QQ 邮箱（如使用，取消注释并修改上面 163 配置）:
# MAIL_HOST=smtp.qq.com
# MAIL_PORT=465
# MAIL_USERNAME=your-email@qq.com
# MAIL_PASSWORD=your-smtp-auth-code

# Gmail（如使用）:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password

# --- 前端地址（用于激活邮件中的链接）---
# APP_FRONTEND_URL=http://localhost:5173

# =============================================================================
# MongoDB 配置（文档内容和自动保存历史，可改为本地地址）
# =============================================================================
# 默认连接远程 117.72.88.11:27017
# 如需本地 MongoDB:
#   1. brew install mongosh mongodb-community
#   2. 在 kb-document/.../application.yml 中修改 spring.data.mongodb 配置

# =============================================================================
# Redis 配置（缓存，可改为本地地址）
# =============================================================================
# 默认连接远程 117.72.88.11:6379
# 如需本地 Redis:
#   1. brew install redis
#   2. 在 kb-graph/.../application.yml 中修改 spring.redis 配置
